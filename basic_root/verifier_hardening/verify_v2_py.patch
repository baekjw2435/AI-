+class _HashingReader(io.RawIOBase):
+    def __init__(self, handle, digest):
+        self._handle, self._digest = handle, digest
+
+    def readable(self):
+        return True
+
+    def readinto(self, buffer):
+        n = self._handle.readinto(buffer)
+        if n:
+            self._digest.update(memoryview(buffer)[:n])
+        return n
+
