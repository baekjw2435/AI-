<style>
/* 원고지: 칸 하나에 음절 하나. 지도는 원고지 한 장, 수순은 원고지 한 줄로 적어 내려간다. */
:root {
  --paper: #fbfcf9;
  --sheet: #ffffff;
  --rule: #9cc3ad;
  --rule-soft: #d7e8de;
  --ink: #1b2620;
  --ink-soft: #55665c;
  --accent: #2f7a55;
  --win: #1f6f4a;
  --win-bg: #dcefe4;
  --lose: #b23a2b;
  --lose-bg: #f7e1dc;
  --open: #6b7570;
  --open-bg: #ecefed;
  --astra: #6a4fa3;
  --astra-bg: #ebe5f6;
  --focus: #1d5fd1;
  --shadow: 0 1px 0 rgba(27, 38, 32, .06);
  --f-display: "Nanum Myeongjo", "AppleMyungjo", "Noto Serif KR", serif;
  --f-body: "IBM Plex Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  --cell: 44px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #101814; --sheet: #142019; --rule: #3b6550; --rule-soft: #22362b; --ink: #e4ede7; --ink-soft: #9db3a6;
    --accent: #6cc79a; --win: #7fd6a6; --win-bg: #173726; --lose: #f19a8a; --lose-bg: #3d1f1a; --open: #a3aea8; --open-bg: #1f2a25;
    --astra: #c2adf0; --astra-bg: #2a2340; --focus: #8ab4ff; --shadow: 0 1px 0 rgba(0, 0, 0, .3); color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #101814; --sheet: #142019; --rule: #3b6550; --rule-soft: #22362b; --ink: #e4ede7; --ink-soft: #9db3a6;
  --accent: #6cc79a; --win: #7fd6a6; --win-bg: #173726; --lose: #f19a8a; --lose-bg: #3d1f1a; --open: #a3aea8; --open-bg: #1f2a25;
  --astra: #c2adf0; --astra-bg: #2a2340; --focus: #8ab4ff; --shadow: 0 1px 0 rgba(0, 0, 0, .3); color-scheme: dark;
}
* { box-sizing: border-box; }
html, body { background: var(--paper); color: var(--ink); }
body { font: 15px/1.6 var(--f-body); }
.wrap { max-width: 1040px; margin: 0 auto; padding-block: 20px 56px; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); display: grid; gap: 22px; }
a { color: var(--accent); }
button { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
h1, h2, h3 { font-family: var(--f-display); font-weight: 800; text-wrap: balance; margin: 0; line-height: 1.25; }
h1 { font-size: clamp(26px, 5vw, 36px); letter-spacing: -.01em; }
h2 { font-size: 21px; }
h3 { font-size: 16px; }
.lede { color: var(--ink-soft); max-width: 62ch; margin: 6px 0 0; }
.eyebrow { font-size: 12px; letter-spacing: .08em; color: var(--ink-soft); }
.mono { font-family: var(--f-mono); font-size: 12px; }

/* 머리말 */
header.top { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px 24px; border-bottom: 2px solid var(--rule); padding-bottom: 14px; }
.tally { display: flex; flex-wrap: wrap; gap: 8px; }
.pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 500; white-space: nowrap; }
.pill.win { background: var(--win-bg); color: var(--win); }
.pill.lose { background: var(--lose-bg); color: var(--lose); }
.pill.open { background: var(--open-bg); color: var(--open); }
.pill.astra { background: var(--astra-bg); color: var(--astra); }
.pill b { font-family: var(--f-mono); font-weight: 500; }

/* 원고지 지도 */
.sheet { background: var(--sheet); border: 1px solid var(--rule); box-shadow: var(--shadow); padding: 14px; }
.grid { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
.cell { position: relative; aspect-ratio: 1; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); display: grid; place-items: center; font-family: var(--f-display); font-weight: 700; font-size: clamp(16px, 2.4vw, 22px); background: none; border-top: 0; border-left: 0; padding: 0; cursor: pointer; min-width: 0; }
.cell.win { background: var(--win-bg); color: var(--win); }
.cell.lose { background: var(--lose-bg); color: var(--lose); }
.cell.astra { background: var(--astra-bg); color: var(--astra); }
.cell.open { color: var(--open); cursor: default; }
.cell .mark { position: absolute; top: 2px; right: 3px; font: 600 10px/1 var(--f-mono); color: var(--lose); }
.cell .ring { position: absolute; inset: 14%; border: 1.5px solid var(--lose); border-radius: 50%; opacity: .45; pointer-events: none; }
.cell .ring.none { border: 1.5px dashed var(--open); opacity: .7; }
.cell .of { position: absolute; bottom: 2px; left: 4px; font: 500 10px/1 var(--f-body); color: var(--ink-soft); }
.cell.dead { cursor: default; background: repeating-linear-gradient(135deg, var(--lose-bg) 0 6px, var(--sheet) 6px 9px); }
.cell:hover:not(.open):not(.dead) { outline: 2px solid var(--accent); outline-offset: -2px; z-index: 1; }
.legend { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: var(--ink-soft); margin-top: 12px; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.sw { width: 14px; height: 14px; border: 1px solid var(--rule); display: inline-block; }
.sw.win { background: var(--win-bg); } .sw.lose { background: var(--lose-bg); } .sw.astra { background: var(--astra-bg); } .sw.open { background: var(--sheet); }
.sw.ring { border-radius: 50%; border: 1.5px solid var(--lose); background: none; }
.sw.none { border-radius: 50%; border: 1.5px dashed var(--open); background: none; }
.sw.dead { background: repeating-linear-gradient(135deg, var(--lose-bg) 0 4px, var(--sheet) 4px 6px); }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip { border: 1px solid var(--rule); background: var(--sheet); padding: 6px 12px; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; font-size: 14px; }
.chip:hover { border-color: var(--accent); }
#view { display: grid; gap: 34px; }
.section > *, #view > * { min-width: 0; }
.section { display: grid; gap: 10px; }
.note { font-size: 13px; color: var(--ink-soft); max-width: 70ch; }

/* 탐색기 */
.bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.btn { border: 1px solid var(--rule); background: var(--sheet); padding: 7px 14px; cursor: pointer; font-size: 14px; }
.btn:hover:not(:disabled) { border-color: var(--accent); }
.btn.primary { background: var(--accent); color: var(--sheet); border-color: var(--accent); font-weight: 600; }
.btn:disabled { opacity: .45; cursor: default; }
.title-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
.meta { font-size: 13px; color: var(--ink-soft); }
.line { display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); background: var(--sheet); }
.word { border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: none; border-top: 0; border-left: 0; padding: 0; cursor: pointer; display: grid; text-align: left; }
.word .boxes { display: flex; }
.word .boxes i { font-style: normal; width: 30px; height: 34px; display: grid; place-items: center; font-family: var(--f-display); font-weight: 700; font-size: 18px; border-right: 1px solid var(--rule-soft); }
.word .boxes i:last-child { border-right: 0; }
.word .who { font-size: 11px; padding: 1px 6px 2px; color: var(--ink-soft); border-top: 1px solid var(--rule-soft); white-space: nowrap; }
.word.recv .boxes { color: var(--accent); }
.word.pres .boxes { color: var(--ink); }
.word.start .boxes { color: var(--ink-soft); }
.word.here { box-shadow: inset 0 -3px 0 var(--accent); }
button.word:hover { background: var(--rule-soft); }
.word.given .boxes { color: var(--ink-soft); }
.now { display: grid; gap: 6px; padding: 14px 16px; border: 1px solid var(--rule); background: var(--sheet); }
.now .big { font-family: var(--f-display); font-size: 20px; font-weight: 800; }
.verdict { display: inline-flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.moves { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 8px; }
.mv { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; align-items: center; text-align: left; border: 1px solid var(--rule); border-left-width: 4px; background: var(--sheet); padding: 9px 12px; cursor: pointer; min-width: 0; }
.mv:hover { border-color: var(--accent); }
.mv.win { border-left-color: var(--win); }
.mv.lose { border-left-color: var(--lose); }
.mv.open { border-left-color: var(--rule); }
.mv .w { font-family: var(--f-display); font-weight: 800; font-size: 18px; overflow-wrap: anywhere; }
.mv .alt { font-size: 12px; color: var(--ink-soft); grid-column: 1 / -1; }
.mv .why { font-size: 13px; color: var(--ink-soft); grid-column: 1 / -1; }
.mv .why b { color: var(--ink); font-weight: 600; }
.tag { font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 999px; white-space: nowrap; }
.tag.win { background: var(--win-bg); color: var(--win); }
.tag.lose { background: var(--lose-bg); color: var(--lose); }
.tag.open { background: var(--open-bg); color: var(--open); }
.loading { color: var(--ink-soft); font-size: 14px; }
.err { color: var(--lose); font-size: 14px; }
details.proofs { font-size: 13px; color: var(--ink-soft); }
details.proofs summary { cursor: pointer; }
.tbl { overflow-x: auto; }
.tbl table { border-collapse: collapse; font-size: 13px; min-width: 520px; }
.tbl th, .tbl td { border-bottom: 1px solid var(--rule-soft); padding: 4px 10px 4px 0; text-align: left; vertical-align: top; }
.tbl td.n { font-family: var(--f-mono); font-variant-numeric: tabular-nums; text-align: right; }
footer { font-size: 12px; color: var(--ink-soft); border-top: 1px solid var(--rule); padding-top: 12px; display: grid; gap: 4px; }
@media (max-width: 640px) {
  .grid { grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .word .boxes i { width: 26px; height: 30px; font-size: 16px; }
}
@media (prefers-reduced-motion: no-preference) {
  .mv, .cell, .chip, .btn { transition: border-color .12s, background-color .12s; }
}
</style>
